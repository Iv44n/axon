# axon settings. Copy this file to ~/.config/axon/config.toml and uncomment what you want to change.
# Everything is optional; a mistake is reported on stderr with its line number and skipped.
# The settings panel (the gear in the title bar, or Ctrl+,) edits and saves this file for you as you change things.
# Press Ctrl+Shift+R in axon to apply the file without restarting.
# The environment variables AXON_FONT, AXON_FONT_SIZE and AXON_OPACITY win over this file.

[font]
# A family name found in ~/.local/share/fonts, ~/.fonts, /usr/local/share/fonts or /usr/share/fonts
# ("JetBrains Mono", "Cascadia Mono NF"...), or the path of a .ttf / .otf file. Default: JetBrains Mono,
# then Cascadia Mono, then DejaVu Sans Mono.
# family = "JetBrains Mono"

# Size in pixels (6 to 96). Ctrl + / Ctrl - zoom for the session; Ctrl+0 comes back to this value.
# size = 15

# 100 (thin) to 900 (black); 400 is the font as drawn. Synthesized for now: lighter thins the edges of
# the glyphs, heavier thickens them sideways.
# weight = 400

# Draw bold text (SGR 1) at weight + 300. Set false to draw bold as regular.
# bold = true

# Extra pixels between letters, at the configured size (-8 to 32). Fractions round to whole pixels.
# letter_spacing = 0

# Row height as a multiple of the font's own height (0.8 to 3).
# line_height = 1.0

# How the edges of the letters are drawn: "rgb" uses the red, green and blue stripes of an LCD panel (as
# GNOME and most terminals do; sharper), "bgr" is the same for panels with the stripes the other way
# round, "gray" uses grey levels only (no colour fringes; for screenshots or unusual panels).
# smoothing = "rgb"

# Snap the baseline, x-height and cap height of the letters to whole pixel rows, so horizontal strokes
# are crisp instead of spread over two rows. Set false to draw the outlines exactly as designed.
# hinting = true

[window]
# How opaque the glass is, 0.3 to 1. There is no blur on GNOME, so below ~0.85 what is behind shows.
# opacity = 0.88

# Ask the compositor to blur what is behind the glass. It is a separate thing from opacity: opacity says
# how much of the window shows through, blur says how sharp it is. It needs a compositor that offers it
# (KDE Plasma, or any with the ext-background-effect protocol); GNOME's Mutter does not, and there this
# changes nothing. Most visible below ~0.85 opacity. The compositor chooses the blur's strength.
# blur = false

# The status bar at the bottom of the window: shell, encoding, git branch (with the chips on), key hints and the
# size of the grid. Off by default (the look has none); it takes 28 px when on.
# status_bar = false

[ui]
# The language of the window's text (the settings panel, the status bar): "auto" follows your locale
# (LC_ALL, LC_MESSAGES, LANG), "en" is English, "es" is Spanish. This file and the command line stay in English.
# language = "auto"

[input]
# What goes on the line above your prompt. "shell" leaves the prompt as your shell draws it. "chips" puts a
# row of context chips (time, user, directory, git branch...) there, right above where you type: the shell
# still edits the line, axon adds the chips. axon starts bash with the hook it needs; for zsh and fish (or a
# bash whose rc file replaces PROMPT_COMMAND) add one line to the shell's rc file:
#   eval "$(axon shell-init bash)"        # zsh: eval "$(axon shell-init zsh)"; fish: axon shell-init fish | source
# mode = "shell"

# 12-hour ("03:48 pm") or 24-hour ("15:48") clock in the time chip.
# clock = "12h"

# The cursor's shape until a program asks for another: "block", "bar" or "underline".
# cursor = "block"

# Suggest the rest of a command while you type it. The setting is read, saved and shown in the settings
# panel already; the line editor that draws the suggestion comes later, so today it changes nothing.
# autosuggest = true

# The chips to show, left to right. One with nothing to say (no git repository, no virtual environment)
# is skipped. Available: time, user, env (conda or venv), pyenv, host (user@host), dir, branch,
# changes (files and lines changed in git), kube (the current kubectl context).
# chips = ["time", "user", "env", "pyenv", "host", "dir", "branch", "changes", "kube"]

[windows]
# Where the list of windows (tabs) lives: "left" or "right" as a panel, or "top" as tabs in the title bar.
# Alt+N opens a window, Alt+W closes it (a toast offers Undo), Alt+1..9 goes to one, Alt+[ and Alt+] go to the
# previous and the next, Alt+O shows them all as cards, Ctrl+K opens the command palette (actions, windows, groups).
# Alt+G makes a group: a coloured container for windows (a dialog, with templates that open windows for you);
# Alt+Shift+G takes the window out of its group. Drag a row or a tab to reorder or regroup it, right click it for
# its menu, double click it to rename it. Windows, groups and names are not saved between runs.
# A group is a split: its windows are shown side by side. Ctrl+Space adds a terminal to the group of the window on
# screen (a window in no group gets one), Alt+\ lays them out in columns, Alt+- in rows, Alt+, and Alt+. move the
# focus, Alt+Shift+W closes the focused one. The panel lists the group's windows as usual.
# tabs = "left"

# Whether the panel is shown (Alt+B toggles it), and its width in pixels (160 to 320).
# side = true
# side_width = 220

# Start every window's shell in a systemd scope of its own (`systemd-run --user --scope`), so what runs from a window
# (an editor, a build, a browser) is counted, and killed under memory pressure, apart from the other windows and not as
# "axon". It is used only where systemd's user manager answers; elsewhere the shell starts as usual. List them with
# `systemd-cgtop` or `systemctl --user list-units --type=scope` (app-axon-<pid>w<window>.scope).
# scope = true
